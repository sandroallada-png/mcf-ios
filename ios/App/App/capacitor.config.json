{
	"appId": "my.cook.flex",
	"appName": "My Cook Flex",
	"webDir": "public",
	"server": {
		"allowNavigation": [
			"app.mycookflex.com",
			"*.mycookflex.com"
		]
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 2000,
			"launchAutoHide": true,
			"backgroundColor": "#0a0a0a",
			"androidScaleType": "CENTER_CROP",
			"showSpinner": true,
			"androidSpinnerStyle": "large",
			"iosSpinnerStyle": "small",
			"spinnerColor": "#f97316"
		},
		"Keyboard": {
			"resize": "body",
			"style": "dark",
			"resizeOnFullScreen": true
		},
		"FirebaseAuthentication": {
			"skipNativeAuth": false,
			"providers": [
				"google.com"
			]
		}
	},
	"packageClassList": [
		"AppPlugin",
		"CAPCameraPlugin",
		"PushNotificationsPlugin",
		"FirebaseAuthenticationPlugin"
	]
}
